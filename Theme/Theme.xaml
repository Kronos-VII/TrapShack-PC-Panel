<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:TrapShack.Ui"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================== PALETTE ============================== -->
    <!-- Change the whole look of the app from here. -->
    <Color x:Key="AccentColor">#E5213B</Color>
    <Color x:Key="AccentHotColor">#FF4D63</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#0B0B0E"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#08080A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#141418"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1A1A20"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#24242B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHotBrush" Color="{StaticResource AccentHotColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33E5213B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9AA7"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#686873"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#3DD68C"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#26262E"/>

    <!-- Derived accent shades. AccentTheme.Apply replaces all of these when the accent changes. -->
    <Color x:Key="AccentDeepColor">#1F0A10</Color>
    <Color x:Key="AccentDeeperColor">#1B0A0E</Color>
    <Color x:Key="AccentGlowColor">#24E5213B</Color>
    <Color x:Key="AccentGlowFadeColor">#00E5213B</Color>
    <Color x:Key="AccentHazeColor">#40E5213B</Color>
    <Color x:Key="AccentHazeFadeColor">#00E5213B</Color>
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#66E5213B"/>
    <SolidColorBrush x:Key="AccentWashBrush" Color="#1F0E13"/>
    <SolidColorBrush x:Key="AccentCardWashBrush" Color="#1D1116"/>
    <SolidColorBrush x:Key="AccentPanelBorderBrush" Color="#3A1219"/>
    <SolidColorBrush x:Key="AccentHoverBorderBrush" Color="#5A1822"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="White"/>
    <Color x:Key="TermAccentColor">#FF4D63</Color>
    <SolidColorBrush x:Key="TermAccentBrush" Color="#FF4D63"/>
    <!-- Theme tokens: every fixed colour in the pages. The light theme swaps these at run time (Ui/ThemeMode.cs). -->
    <SolidColorBrush x:Key="Ink_22FFFFFF" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Ink_26F5A524" Color="#26F5A524"/>
    <SolidColorBrush x:Key="Ink_55FFFFFF" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="Ink_66FFFFFF" Color="#66FFFFFF"/>
