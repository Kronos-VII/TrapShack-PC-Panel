    <SolidColorBrush x:Key="Ink_FF101014" Color="#FF101014"/>
    <SolidColorBrush x:Key="Ink_FF111116" Color="#FF111116"/>
    <SolidColorBrush x:Key="Ink_FF12221A" Color="#FF12221A"/>
    <SolidColorBrush x:Key="Ink_FF131317" Color="#FF131317"/>
    <SolidColorBrush x:Key="Ink_FF131318" Color="#FF131318"/>
    <SolidColorBrush x:Key="Ink_FF141418" Color="#FF141418"/>
    <SolidColorBrush x:Key="Ink_FF15151A" Color="#FF15151A"/>
    <SolidColorBrush x:Key="Ink_FF16161B" Color="#FF16161B"/>
    <SolidColorBrush x:Key="Ink_FF16161C" Color="#FF16161C"/>
    <SolidColorBrush x:Key="Ink_FF17171C" Color="#FF17171C"/>
    <SolidColorBrush x:Key="Ink_FF17171D" Color="#FF17171D"/>
    <SolidColorBrush x:Key="Ink_FF18181E" Color="#FF18181E"/>
    <SolidColorBrush x:Key="Ink_FF1A1A20" Color="#FF1A1A20"/>
    <SolidColorBrush x:Key="Ink_FF1A1A21" Color="#FF1A1A21"/>
    <SolidColorBrush x:Key="Ink_FF1A2A22" Color="#FF1A2A22"/>
    <SolidColorBrush x:Key="Ink_FF1C1C22" Color="#FF1C1C22"/>
    <SolidColorBrush x:Key="Ink_FF1D1D23" Color="#FF1D1D23"/>
    <SolidColorBrush x:Key="Ink_FF1D1D24" Color="#FF1D1D24"/>
    <SolidColorBrush x:Key="Ink_FF1E1812" Color="#FF1E1812"/>
    <SolidColorBrush x:Key="Ink_FF1E1E25" Color="#FF1E1E25"/>
    <SolidColorBrush x:Key="Ink_FF1F4A33" Color="#FF1F4A33"/>
    <SolidColorBrush x:Key="Ink_FF241E10" Color="#FF241E10"/>
    <SolidColorBrush x:Key="Ink_FF24242B" Color="#FF24242B"/>
    <SolidColorBrush x:Key="Ink_FF26262E" Color="#FF26262E"/>
