    <SolidColorBrush x:Key="Ink_FF33333C" Color="#FF33333C"/>
    <SolidColorBrush x:Key="Ink_FF34343D" Color="#FF34343D"/>
    <SolidColorBrush x:Key="Ink_FF34343E" Color="#FF34343E"/>
