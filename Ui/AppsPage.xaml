<UserControl x:Class="TrapShack.Ui.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <ui:InverseBoolToVisibility x:Key="InvB2V"/>

        <!-- one tile: same look as the setting tiles -->
        <Style x:Key="AppTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="12,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- logo tile -->
        <DataTemplate x:Key="LogoTile">
            <Border Width="40" Height="40" CornerRadius="10" Background="{Binding Art.Tile}" VerticalAlignment="Center">
                <Grid>
                    <Image Source="{Binding Art.Photo}" Visibility="{Binding Art.PhotoVisible}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Viewbox Width="22" Height="22" Visibility="{Binding Art.IconVisible}">
                        <Path Data="{Binding Art.Icon}" Fill="{Binding Art.Glyph}" Width="24" Height="24" Stretch="Uniform"/>
                    </Viewbox>
                    <Image Source="{Binding Art.RealIcon}" Visibility="{Binding Art.RealVisible}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Art.Mono}" Visibility="{Binding Art.MonoVisible}" Foreground="{Binding Art.Glyph}"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ONE APP -->
        <DataTemplate DataType="{x:Type ui:AppCardVM}">
            <Border Style="{StaticResource AppTile}" MouseLeftButtonUp="OnCardClick" ui:Fx.Glow="True" ui:Fx.Rise="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl ContentTemplate="{StaticResource LogoTile}" Content="{Binding}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" ToolTip="{Binding Desc}"
                                   Visibility="{Binding HasPhase, Converter={StaticResource InvB2V}}"/>
                        <TextBlock Text="{Binding Phase}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Visibility="{Binding HasPhase, Converter={StaticResource B2V}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- right side: tick box when not installed; "Installed" and a remove button when it is -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <CheckBox Style="{StaticResource TsCheck}" IsChecked="{Binding Selected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelect}" Visibility="{Binding NotInstalled, Converter={StaticResource B2V}}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowInstalled}">
                            <Border CornerRadius="5" Padding="7,1.5" Background="{DynamicResource Ink_FF12221A}" VerticalAlignment="Center">
                                <TextBlock Text="Installed" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/>
                            </Border>
                            <Button Content="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11.5" Style="{StaticResource GhostButton}" Padding="7,4" Margin="8,0,0,0"
                                    ToolTip="Uninstall" Click="OnUninstallClick" VerticalAlignment="Center"
                                    Visibility="{Binding CanUninstall, Converter={StaticResource B2V}}" IsEnabled="{Binding CanUninstall}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- RUNTIME THAT COMES IN 64-bit AND 32-bit: one row, both builds on the right -->
        <DataTemplate DataType="{x:Type ui:PairCardVM}">
            <Border Style="{StaticResource AppTile}" Cursor="Arrow" ui:Fx.Glow="True" ToolTip="{Binding Desc}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentControl ContentTemplate="{StaticResource LogoTile}" Content="{Binding}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Both builds are usually needed" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid DataContext="{Binding X64}" Margin="0,0,14,0">
                            <CheckBox Style="{StaticResource TsCheck}" Content="64-bit" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}" Visibility="{Binding NotInstalled, Converter={StaticResource B2V}}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowInstalled}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="64-bit" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid DataContext="{Binding X86}">
                            <CheckBox Style="{StaticResource TsCheck}" Content="32-bit" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}" Visibility="{Binding NotInstalled, Converter={StaticResource B2V}}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowInstalled}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="32-bit" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: title left, search right -->
        <Grid Grid.Row="0" Margin="34,4,34,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,20,0">
                <TextBlock Text="DEBLOAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"/>
                <TextBlock Text="Apps" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="Subtitle" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           Text="Game launchers, runtimes and everyday apps, installed through Windows' own package manager."/>
                <Border x:Name="WingetNotice" Visibility="Collapsed" Background="{DynamicResource Ink_FF1E1812}" BorderBrush="{DynamicResource Ink_FF4A3716}" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,10,0,0">
                    <TextBlock Foreground="{DynamicResource AmberBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Text="Windows' package manager (winget) isn't available on this PC, so installing is switched off. Update “App Installer” in the Microsoft Store, then reopen TrapShack."/>
                </Border>
            </StackPanel>
            <Grid Grid.Column="1" Width="300" VerticalAlignment="Bottom">
                <TextBox x:Name="Search" TextChanged="OnSearchChanged" Height="40" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="13"
                         Background="{DynamicResource Ink_FF141418}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource Ink_FF2A2A32}"
                         CaretBrush="{DynamicResource AccentHotBrush}"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False" Foreground="{DynamicResource FaintBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchHint" Text="Search apps   Ctrl+F" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="34,0,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- categories -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="CATEGORIES" Style="{StaticResource RailLabel}"/>
                    <ItemsControl x:Name="Rail">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource RailButton}" GroupName="appsrail" IsChecked="{Binding Selected, Mode=OneWay}" Checked="OnRailChecked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource Ink_FF1E1E25}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="12,14,8,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Installed" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="StatInstalled" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button x:Name="RuntimeChip" Style="{StaticResource MiniButton}" HorizontalAlignment="Left" Margin="-6,10,0,0" Visibility="Collapsed" Click="OnRuntimeChipClick">
                                <TextBlock x:Name="RuntimeChipText" Foreground="{DynamicResource AmberBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- the chosen category -->
            <ScrollViewer x:Name="Scroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,24">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PaneGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="PaneTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PaneDesc" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="PaneProgress" Grid.Column="2" Width="140" VerticalAlignment="Center">
                                <TextBlock x:Name="PaneCount" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                                <ProgressBar x:Name="PaneBar" Style="{StaticResource ThinBar}" Height="4" Margin="0,6,0,0" Maximum="1"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="Sections">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Grid Margin="2,0,0,10" Visibility="{Binding ShowTitle, Converter={StaticResource B2V}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Counter}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="10,1,0,0"/>
                                        <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource Ink_FF1E1E25}" VerticalAlignment="Center" Margin="14,2,0,0"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><ui:AdaptiveGrid Columns="2" MinItemWidth="380" Gap="10" RowHeight="64"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoMatch" Text="Nothing matches that." Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- selection bar -->
        <Border x:Name="PickBar" Grid.Row="2" Margin="34,6,34,14" Padding="18,11" CornerRadius="12" Background="{DynamicResource Ink_FF131317}" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PickText" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PickSub" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear" Style="{StaticResource GhostButton}" Click="OnClearPicks" Margin="0,0,10,0"/>
                <Button x:Name="InstallBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="OnInstallClick" MinWidth="150"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
