<Window x:Class="TrapShack.Ui.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="500" MaxHeight="680"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource TextBrush}">
    <Border Background="#101014" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="14"
            MouseLeftButtonDown="OnDrag">
        <Grid Margin="28,26,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="1" Margin="0,14,0,22" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" FontSize="13.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="#C9C9D3"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                        IsCancel="True" Click="OnSecondary"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="OnPrimary"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
