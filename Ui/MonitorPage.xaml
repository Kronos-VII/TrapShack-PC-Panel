<UserControl x:Class="TrapShack.Ui.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <UserControl.Resources>
        <!-- the colour of a reading: green when cool, amber when warm, accent red when hot -->
        <Style x:Key="LevelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ok"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="warm"><Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="hot"><Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type ui:MonitorDeviceVM}">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,16,18,14"
                    ui:Fx.Glow="True">
                <StackPanel>
                    <!-- device -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Name}"/>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="5" Padding="8,2" VerticalAlignment="Center" Background="{DynamicResource Ink_FF1F1F26}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="none"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Style="{StaticResource LevelText}"/>
                        </Border>
                    </Grid>

                    <!-- the figure -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Headline}" FontSize="40" FontWeight="Bold" Style="{StaticResource LevelText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Peak}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                    </Grid>

                    <!-- a minute of history -->
                    <TextBlock Text="{Binding GraphLabel}" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,10,0,6"/>
                    <Border Height="80" CornerRadius="8" Background="{DynamicResource Ink_FF101014}" ClipToBounds="True">
                        <Grid>
                            <Rectangle Height="1" Fill="{DynamicResource Ink_FF1E1E25}" VerticalAlignment="Center"/>
                            <Viewbox Stretch="Fill">
                                <Canvas Width="300" Height="80">
                                    <Polygon Points="{Binding Area}">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource AccentGlowFadeColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>
                                    <Polyline Points="{Binding Line}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- the details, two to a row -->
                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,14,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="34,4,34,20">
            <TextBlock Text="SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"/>
            <TextBlock Text="Temperatures" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="Note" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                       Text="Starting the sensors…"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,0,34,24">
                <ItemsControl x:Name="Cards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="320" Gap="14"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="2,16,0,0" TextWrapping="Wrap"
                           Text="Green is cool, amber is warm, red is hot (85 °C and up for a processor, 83 °C for a graphics card). Hot under a long game or render is normal for a short while; hot at rest means the cooling needs a look."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
