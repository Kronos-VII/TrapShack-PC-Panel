<UserControl x:Class="TrapShack.Ui.DebloatAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <ui:InverseBoolToVisibility x:Key="InvB2V"/>

        <Style x:Key="TagBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Ink_FF1C1C22}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ink_FF2E2E37}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TagKind}" Value="core">
                    <Setter Property="Background" Value="{DynamicResource Ink_FF241E10}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink_FF4A3716}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource Ink_FF241E10}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink_FF4A3716}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="perm">
                    <Setter Property="Background" Value="{DynamicResource Ink_FF2A1317}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentPanelBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="keep">
                    <Setter Property="Background" Value="{DynamicResource Ink_FF2A1317}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentPanelBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="done">
                    <Setter Property="Background" Value="{DynamicResource Ink_FF12221A}"/><Setter Property="BorderBrush" Value="{DynamicResource Ink_FF1F4A33}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TagKind}" Value="core"><Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="warn"><Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="perm"><Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="keep"><Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding TagKind}" Value="done"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource AccentCardWashBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Locked}" Value="True"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value="0.72"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type ui:WinAppVM}">
            <Border Style="{StaticResource AppTile}" MouseLeftButtonUp="OnRowClick" ui:Fx.Glow="True" ui:Fx.Rise="True" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="11" Background="{Binding TileBg}" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{Binding GlyphFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoPhoto}"/>
                            <Image Source="{Binding Photo}" Width="30" Height="30" Visibility="{Binding HasPhoto}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Width="42" Height="42" CornerRadius="11" Background="{Binding Art.Tile}" Visibility="{Binding HasArt}">
                                <Grid>
                                    <Image Source="{Binding Art.Photo}" Visibility="{Binding Art.PhotoVisible}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Viewbox Width="22" Height="22" Visibility="{Binding Art.IconVisible}">
                                        <Path Data="{Binding Art.Icon}" Fill="{Binding Art.Glyph}" Width="24" Height="24" Stretch="Uniform"/>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Art.Mono}" Visibility="{Binding Art.MonoVisible}" Foreground="{Binding Art.Glyph}"
                                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AmberBrush}" Margin="0,1,6,0"
                                       VerticalAlignment="Center" Visibility="{Binding HasWarning, Converter={StaticResource B2V}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock Text="{Binding Desc}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="30" LineHeight="15" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right">
                        <CheckBox Style="{StaticResource TsCheck}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                  Visibility="{Binding Locked, Converter={StaticResource InvB2V}}" HorizontalAlignment="Right"/>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource FaintBrush}"
                                   Visibility="{Binding Locked, Converter={StaticResource B2V}}" HorizontalAlignment="Right"/>
                        <Border Style="{StaticResource TagBox}" Margin="0,6,0,0" Padding="7,2" HorizontalAlignment="Right"
                                Visibility="{Binding ShowTag, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding ShortTag}" FontSize="10.5" Style="{StaticResource TagText}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="34,4,34,10">
            <TextBlock Text="DEBLOAT" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,2"/>
            <TextBlock Text="Debloat apps" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="The Windows apps found on this PC. Tick the ones you don't use. Locked apps are needed by Windows."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="34,0,34,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="Search" TextChanged="OnSearchChanged" Padding="36,9,12,9" FontSize="13" Background="{DynamicResource Ink_FF141418}"
                         Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource Ink_FF2A2A32}" CaretBrush="{DynamicResource AccentHotBrush}"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False" Foreground="{DynamicResource FaintBrush}" Margin="13,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchHint" Text="Search Windows apps   (Ctrl+F)" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource Ink_FF1C1C22}" BorderBrush="{DynamicResource Ink_FF33333C}" BorderThickness="1">
                    <TextBlock x:Name="StatFound" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <Button Content="Pick the safe ones" Style="{StaticResource GhostButton}" Click="OnPickSafe" Margin="0,0,8,0"
                        ToolTip="Picks the apps that are safe for everyone to remove. Optional and core apps are left alone."/>
                <Button Content="Clear" Style="{StaticResource GhostButton}" Click="OnClear"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,0,34,16">
                <TextBlock x:Name="Loading" Text="Looking at what's installed…" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0"/>
                <TextBlock x:Name="Empty" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                <ItemsControl x:Name="Tiles">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="190" Gap="10" RowHeight="76"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="PickBar" Grid.Row="3" Margin="34,6,34,14" Padding="18,11" CornerRadius="12" Background="{DynamicResource Ink_FF131317}" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PickText" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PickSub" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Clear" Style="{StaticResource GhostButton}" Click="OnClear" Margin="0,0,10,0"/>
                <Button x:Name="RemoveBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="OnRemoveClick" MinWidth="150"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
