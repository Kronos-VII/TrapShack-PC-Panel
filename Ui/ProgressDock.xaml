<UserControl x:Class="TrapShack.Ui.ProgressDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <Border x:Name="Card" MinWidth="460" MaxWidth="760" Margin="24,0,24,22" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#131317" BorderBrush="#34343D" BorderThickness="1" CornerRadius="14" Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="28"/>
        </Border.RenderTransform>
        <Border CornerRadius="13" ClipToBounds="True">
            <StackPanel>
                <Grid Margin="16,13,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse x:Name="Spin" Width="16" Height="16" StrokeThickness="2.2" StrokeDashArray="3 2.1"
                                 Stroke="{DynamicResource AccentHotBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="SpinRot"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ConsoleBtn" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="9,3" Margin="0,0,10,0"
                                Click="OnToggleConsole" ToolTip="Show the commands TrapShack is running">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,6,0" Foreground="{DynamicResource AccentHotBrush}"/>
                                <TextBlock x:Name="ConsoleBtnText" Text="Console"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PercentText" FontSize="13" FontWeight="SemiBold" MinWidth="40" TextAlignment="Right"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="CancelBtn" Grid.Column="3" Style="{StaticResource GhostButton}" Content="Stop" FontSize="12.5"
                            Margin="12,0,0,0" Padding="0" Click="OnCancel" Visibility="Collapsed"/>
                    <Button x:Name="CloseBtn" Grid.Column="3" Style="{StaticResource GhostButton}" Content="Close" FontSize="12.5"
                            Margin="12,0,0,0" Click="OnClose" Visibility="Collapsed"/>
                </Grid>
                <ProgressBar x:Name="Bar" Style="{StaticResource ThinBar}" Height="4" Value="0"/>
                <!-- the console: what is being run, in the app's own colours -->
                <Border x:Name="ConsoleBox" Visibility="Collapsed" Padding="10,0,10,10">
                    <ui:TerminalView x:Name="ConsoleTerm" Height="210" Compact="True" Title="Console"/>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
