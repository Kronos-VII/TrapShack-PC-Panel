<UserControl x:Class="TrapShack.Ui.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- one startup program: icon, name, who made it, how much it slows startup, switch -->
        <DataTemplate DataType="{x:Type ui:StartupVM}">
            <Border x:Name="Row" Style="{StaticResource RowShell}" ui:Fx.Glow="True" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Ink_FF1D1D24}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentHotBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoIcon, Converter={StaticResource B2V}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="5" Padding="7,1.5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Ink_FF1F1F26}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImpactLevel}" Value="none"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding ImpactLevel}" Value="high">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHotBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImpactLevel}" Value="medium">
                                        <Setter Property="Background" Value="{DynamicResource Ink_26F5A524}"/>
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AmberBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ImpactShort}" FontSize="10.5" FontWeight="SemiBold"/>
                    </Border>
                    <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding NotBusy}" Click="OnSwitch"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.72"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- header: title left, search right -->
        <Grid Grid.Row="0" Margin="34,4,34,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,20,0">
                <TextBlock Text="TOOLS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"/>
                <TextBlock Text="Startup apps" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           Text="Programs that open with Windows. Switching one off works like Task Manager and can be undone."/>
            </StackPanel>
            <Grid Grid.Column="1" Width="300" VerticalAlignment="Bottom">
                <TextBox x:Name="Search" TextChanged="OnSearchChanged" Height="40" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="13"
                         Background="{DynamicResource Ink_FF141418}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource Ink_FF2A2A32}"
                         CaretBrush="{DynamicResource AccentHotBrush}"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False" Foreground="{DynamicResource FaintBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SearchHint" Text="Search startup apps   Ctrl+F" IsHitTestVisible="False" FontSize="13" Foreground="{DynamicResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="34,0,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="SHOW" Style="{StaticResource RailLabel}"/>
                    <ItemsControl x:Name="Rail">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource RailButton}" GroupName="startrail" IsChecked="{Binding Selected, Mode=OneWay}" Checked="OnRailChecked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource Ink_FF1E1E25}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="12,14,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="Last startup took" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="StatBoot" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink_FFD7D7DE}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Start with Windows" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="StatOn" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="Scroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,24">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PaneGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PaneTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PaneDesc" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Loading" Text="Finding startup programs…" Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,0"/>
                    <TextBlock x:Name="Empty" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,0"/>
                    <ItemsControl x:Name="Tiles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ui:AdaptiveGrid Columns="2" MinItemWidth="380" Gap="10" RowHeight="64"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="2,14,0,0" TextWrapping="Wrap"
                               Text="Startup delay is what Windows itself measured and recorded on this PC. Programs Windows never flagged as slowing startup show no figure."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
