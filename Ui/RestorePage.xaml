<UserControl x:Class="TrapShack.Ui.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- one restore point: the same 64 px row as every list page -->
        <DataTemplate DataType="{x:Type ui:RestoreVM}">
            <Border Style="{StaticResource RowShell}" ui:Fx.Glow="True" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Ink_FF1D1D24}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentHotBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="5" Padding="7,1.5" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource Ink_FF1F1F26}">
                        <TextBlock Text="{Binding Ago}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" FontSize="12" Padding="10,4" Height="34" VerticalAlignment="Center" Click="OnDelete"
                            IsEnabled="{Binding NotBusy}" ToolTip="Delete this restore point">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AccentHotBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- header: title left, the main action right -->
        <Grid Grid.Row="0" Margin="34,4,34,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,20,0">
                <TextBlock Text="TOOLS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"/>
                <TextBlock Text="Restore points" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           Text="Snapshots of Windows' settings and system files. Make one before big changes."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="TurnOnBtn" Style="{StaticResource GhostButton}" Height="40" Content="Turn on System Restore" Margin="0,0,10,0" Visibility="Collapsed" Click="OnTurnOn"/>
                <Button x:Name="RestoreBtn" Style="{StaticResource GhostButton}" Height="40" Content="Go back to a restore point" Margin="0,0,10,0" Click="OnOpenRestore"
                        ToolTip="Opens Windows' System Restore, where you pick the point to go back to"/>
                <Button x:Name="CreateBtn" Style="{StaticResource PrimaryButton}" Height="40" Click="OnCreate">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0"/>
                        <TextBlock Text="Create restore point"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="34,0,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="SHOW" Style="{StaticResource RailLabel}"/>
                    <ItemsControl x:Name="Rail">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource RailButton}" GroupName="restorerail" IsChecked="{Binding Selected, Mode=OneWay}" Checked="OnRailChecked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource Ink_FF1E1E25}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="12,14,8,0">
                        <Grid>
                            <TextBlock Text="System Restore" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="StatOn" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="Scroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,14,24">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTitle" Text="Checking System Restore…" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="StatusLine" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="Empty" Margin="2,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Looking for restore points…"/>
                    <ItemsControl x:Name="Points">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ui:AdaptiveGrid Columns="2" MinItemWidth="380" Gap="10" RowHeight="64"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="2,14,0,0" TextWrapping="Wrap"
                               Text="Windows keeps restore points in a share of your drive and removes the oldest when it fills up. Deleting one can't be undone."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
