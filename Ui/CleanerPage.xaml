<UserControl x:Class="TrapShack.Ui.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrapShack.Ui">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- one rule inside a category card -->
        <DataTemplate DataType="{x:Type ui:CleanRuleVM}">
            <Border x:Name="Row" Padding="8,5,6,5" CornerRadius="8" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnRuleRowClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource TsCheck}" IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"
                               ToolTip="{Binding Name}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11.5" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFound}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#17171D"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one category card -->
        <DataTemplate x:Key="CleanCard" DataType="{x:Type ui:CleanCategoryVM}">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="10,12,10,8"
                    ui:Fx.Rise="True">
                <StackPanel>
                    <Grid Margin="6,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentHotBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource FaintBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}"
                                   VerticalAlignment="Center" Margin="8,0,10,0"/>
                        <CheckBox Grid.Column="3" Style="{StaticResource TsCheck}" IsChecked="{Binding AllChecked, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                                  VerticalAlignment="Center" ToolTip="Tick or untick everything in this group"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#1E1E25" Margin="6,0,6,4"/>
                    <ItemsControl ItemsSource="{Binding Rules}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="34,4,34,10">
            <TextBlock Text="TOOLS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,2"/>
            <TextBlock Text="PC Cleaner" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="Finds temporary files, caches and leftovers from Windows and the apps on this PC. Only the safe cleaning rules are used, and everything they cover is ticked for you."/>
        </StackPanel>

        <!-- hero: the scan ring, what is happening, and the two buttons -->
        <Border Grid.Row="1" Margin="34,0,34,12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                CornerRadius="16" Padding="22,18" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- glow behind the ring -->
                <Ellipse Width="260" Height="260" Margin="-60,-60,0,-60" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentGlowFadeColor}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Width="156" Height="156" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="9" Margin="4"/>
                    <Path x:Name="Arc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/>
                        </Path.Effect>
                    </Path>
                    <!-- the spinning sweep shown while scanning or cleaning -->
                    <Ellipse x:Name="Sweep" Margin="4" StrokeThickness="9" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHotColor}" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.51"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform><RotateTransform x:Name="SweepTurn"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="BigSize" Text="0 B" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BigLabel" Text="ready" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StateTitle" Text="Ready to scan" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StateLine" FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Text="Press Scan to see how much space can be freed. Nothing is deleted until you press Clean."/>
                    <ItemsControl x:Name="Chips" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,3" Margin="0,0,6,6" Background="#1C1C22" BorderBrush="#33333C" BorderThickness="1">
                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ScanBtn" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="OnScanClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ScanIcon" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0"/>
                                <TextBlock x:Name="ScanText" Text="Scan"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CleanBtn" Style="{StaticResource GhostButton}" MinWidth="130" Margin="10,0,0,0" IsEnabled="False" Click="OnCleanClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0"/>
                                <TextBlock x:Name="CleanText" Text="Clean"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetBtn" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Tick the safe ones" Click="OnResetTicks"
                                ToolTip="Ticks every rule again, as it was when the page opened"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- search -->
        <Grid Grid.Row="2" Margin="34,0,34,10">
            <TextBox x:Name="Search" TextChanged="OnSearchChanged" Padding="36,9,12,9" FontSize="13" Background="#141418"
                     Foreground="{StaticResource TextBrush}" BorderBrush="#2A2A32" CaretBrush="{DynamicResource AccentHotBrush}"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False" Foreground="{StaticResource FaintBrush}" Margin="13,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SearchHint" Text="Search cleaning rules   (Ctrl+F)" IsHitTestVisible="False" FontSize="13" Foreground="{StaticResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,0,34,20">
                <TextBlock x:Name="Loading" Text="Finding the programs on this PC…" Foreground="{StaticResource MutedBrush}" Margin="2,6,0,0"/>
                <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource CleanCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ui:MasonryPanel Columns="3" MinColumnWidth="290" Gap="12"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Cleaning rules: winapp2.ini (CC BY-SA 4.0)" FontSize="11" Foreground="#4C4C57" Margin="2,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
