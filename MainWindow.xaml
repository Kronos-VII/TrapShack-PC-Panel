<Window x:Class="TrapShack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TrapShack.Ui"
        Title="TrapShack Tweak Utility" Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded" StateChanged="OnStateChanged" SizeChanged="OnWindowSizeChanged" PreviewKeyDown="OnWindowKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Section title that folds its cards up -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,4,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Car" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="2,0,9,0"
                                           Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Car" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Car" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small pill used for Recommended / Caution / Not available -->
        <!-- a quick-jump tile on the Home page: icon in Content, title and line in the DataContext -->
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentHotBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FitPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FitKind}" Value="Recommended">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHotBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitKind}" Value="Caution">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="{DynamicResource Ink_26F5A524}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitKind}" Value="Unavailable">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="{DynamicResource Ink_22FFFFFF}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink_FF9A9AA7}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ One setting: a compact card (title, two-line summary, info + switch on the right) ============ -->
        <DataTemplate DataType="{x:Type ui:TweakVM}">
            <Border Padding="12,10,10,10" CornerRadius="11" BorderThickness="1" ui:Fx.Glow="True" ui:Fx.Rise="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPanelBorderBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Ink_FF3A3A45}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Width="30" Height="30" CornerRadius="8" Margin="0,1,11,0" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Ink_FF1D1D24}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RowGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAdvanced}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="36" LineHeight="17" VerticalAlignment="Top" Margin="0,1,10,0" ToolTip="{Binding Title}"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16" Margin="0,2,10,0" VerticalAlignment="Top"/>

                    <!-- right side: what-it-does button and the switch -->
                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,1,0,0">
                        <ToggleButton x:Name="InfoBtn" Style="{StaticResource InfoToggle}" ToolTip="What this does" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Grid VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                          Visibility="{Binding IsSwitch, Converter={StaticResource B2V}}" Click="OnSwitchClick"/>
                            <Button Style="{StaticResource MiniButton}" Content="Run now" IsEnabled="{Binding CanToggle}"
                                    Visibility="{Binding IsOneShot, Converter={StaticResource B2V}}" Click="OnRunNowClick"/>
                        </Grid>
                    </StackPanel>
                    <Popup IsOpen="{Binding IsChecked, ElementName=InfoBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=InfoBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                        <Border Background="{DynamicResource Ink_FF111116}" BorderBrush="{DynamicResource Ink_FF34343D}" BorderThickness="1" CornerRadius="12" Padding="16,14" Width="390">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                            </Border.LayoutTransform>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DetailText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource Ink_FFC7C7D1}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource AmberBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="WHAT IT CHANGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding ChangeLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RestoreNote}" FontSize="12" Foreground="{DynamicResource AccentHotBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- footer only when there is something to say (Caution, Restart required ...) -->
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,7,0,0"
                                Visibility="{Binding HasFooter, Converter={StaticResource B2V}}">
                        <Border Style="{StaticResource FitPill}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding FitText}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Visibility="{Binding HasTags, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- one page on the Optimizations hub -->
        <DataTemplate x:Key="HubCard" DataType="{x:Type ui:HubRow}">
            <Border Tag="{Binding Key}" MouseLeftButtonUp="OnHubRowClick" Padding="18,16,18,14" CornerRadius="14" BorderThickness="1" Cursor="Hand"
                    ui:Fx.Glow="True" ui:Fx.Rise="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,13,0">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentHotBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Groups}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="16" Margin="0,12,0,0" VerticalAlignment="Top"/>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding HasRec, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource ThinBar}" Height="4" Value="{Binding RecFill, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Rec}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}" Margin="10,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,9,0,0">
                        <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource Ink_FF1C1C22}">
                            <TextBlock Text="{Binding Def}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource Ink_FF2A2412}" Visibility="{Binding HasCustom, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding Custom}" FontSize="11" Foreground="{DynamicResource AmberBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>


        <!-- the big card on the Optimizations page -->
        <DataTemplate x:Key="HubFeaturedCard" DataType="{x:Type ui:HubRow}">
            <Border Tag="{Binding Key}" MouseLeftButtonUp="OnHubRowClick" Padding="22,20,22,18" CornerRadius="16" BorderThickness="1" Cursor="Hand"
                    BorderBrush="{DynamicResource AccentPanelBorderBrush}" ui:Fx.Glow="True" ui:Fx.Rise="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="{DynamicResource AccentDeepColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource InkC_FF141418}" Offset="0.65"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource AccentHotBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock Grid.Row="2" Text="{Binding FullGroups}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                        <StackPanel Visibility="{Binding HasRec, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding RecShort}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}"/>
                            <TextBlock Text="recommended settings on" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            <ProgressBar Style="{StaticResource ThinBar}" Height="6" Margin="0,12,0,0" Value="{Binding RecFill, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource Ink_FF1C1C22}">
                                <TextBlock Text="{Binding Def}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource Ink_FF2A2412}" Visibility="{Binding HasCustom, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding Custom}" FontSize="11" Foreground="{DynamicResource AmberBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============ DEBLOAT PAGE: one compact row per setting inside a category card ============ -->
        <!-- ============ LIST PAGES: the shared parts (category list, header, 64 px rows) ============ -->

        <!-- one label on a row: red = recommended, amber = read first, grey = good to know -->
        <Style x:Key="RowLabel" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Ink_FF1F1F26}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LabelKind}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LabelKind}" Value="rec">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHotBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LabelKind}" Value="warn">
                    <Setter Property="Background" Value="{DynamicResource Ink_26F5A524}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AmberBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- what-it-does pop-up, shared by every setting row -->
        <DataTemplate x:Key="InfoPopupBody">
            <Border Background="{DynamicResource Ink_FF111116}" BorderBrush="{DynamicResource Ink_FF34343D}" BorderThickness="1" CornerRadius="12" Padding="16,14" Width="390">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                </Border.LayoutTransform>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource Ink_FFC7C7D1}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource AmberBrush}" Margin="0,8,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding Tags}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasTags, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="WHAT IT CHANGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,12,0,4"/>
                    <ItemsControl ItemsSource="{Binding ChangeLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RestoreNote}" FontSize="12" Foreground="{DynamicResource AccentHotBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- a setting: icon, name + one label, one-line summary, info, switch (or Run) -->
        <DataTemplate x:Key="SettingRow" DataType="{x:Type ui:TweakVM}">
            <Border Style="{StaticResource RowShell}" ui:Fx.Glow="True" ToolTip="{Binding Summary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Ink_FF1D1D24}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RowGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FitKind}" Value="Unavailable"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Grid.Column="1" Style="{StaticResource RowLabel}">
                                <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="InfoBtn" Grid.Column="2" Style="{StaticResource InfoToggle}" ToolTip="What this does" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Popup Grid.Column="2" IsOpen="{Binding IsChecked, ElementName=InfoBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=InfoBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource InfoPopupBody}"/>
                    </Popup>
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                      Visibility="{Binding IsSwitch, Converter={StaticResource B2V}}" Click="OnSwitchClick"/>
                        <Button Style="{StaticResource MiniButton}" Content="Run" MinWidth="58" IsEnabled="{Binding CanToggle}"
                                Visibility="{Binding IsOneShot, Converter={StaticResource B2V}}" Click="OnRunNowClick"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- a choice: the same row, with the picker where the switch goes -->
        <DataTemplate x:Key="ChoiceRow" DataType="{x:Type ui:ChoiceVM}">
            <Border Style="{StaticResource RowShell}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource Ink_FF1D1D24}">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="Drop" Grid.Column="2" Width="210" IsEnabled="{Binding CanPick}" Cursor="Hand" VerticalAlignment="Center" ToolTip="{Binding Tip}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Height="34" Background="{DynamicResource Ink_FF101014}" BorderBrush="{DynamicResource Ink_FF2A2A32}" BorderThickness="1" CornerRadius="8" Padding="11,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedLabel}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/></Trigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup Grid.Column="2" IsOpen="{Binding IsChecked, ElementName=Drop, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Drop}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4"
                           MinWidth="{Binding ActualWidth, ElementName=Drop}">
                        <Border Background="{DynamicResource Ink_FF111116}" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                            </Border.LayoutTransform>
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnChoicePick" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Ob" Background="Transparent" CornerRadius="7" Padding="10,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                       Foreground="{DynamicResource AccentHotBrush}" VerticalAlignment="Center" Visibility="Hidden"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ob" Property="Background" Value="{DynamicResource Ink_FF1D1D24}"/></Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </DataTemplate>

        <ui:DebloatRowSelector x:Key="RowSel" TweakTemplate="{StaticResource SettingRow}" ChoiceTemplate="{StaticResource ChoiceRow}"/>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform><ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========================== SIDEBAR =========================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource Ink_FF17171C}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,18">
                    <Grid Width="44" Height="44">
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="Assets/logo.png" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRAPSHACK" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="TWEAK UTILITY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="22,10,16,18">
                    <TextBlock x:Name="SidebarSystem" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="v0.1.0" FontSize="11" Foreground="{DynamicResource Ink_FF4C4C57}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Rectangle Height="1" Fill="{DynamicResource Ink_FF17171C}" Margin="16,0,16,8"/>
                    <RadioButton x:Name="NavTemps" Style="{StaticResource NavButton}" Tag="&#xE9D9;"
                                 Content="Temperatures" GroupName="nav" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE770;"
                                 Content="System info" GroupName="nav" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 Content="Settings" GroupName="nav" Checked="OnNavChecked"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Margin="0,2,0,0"
                                     Content="Home" GroupName="nav" IsChecked="True" Checked="OnNavChecked"/>
                        <StackPanel x:Name="NavHost"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- =========================== CONTENT =========================== -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.9" RadiusY="0.7">
                    <GradientStop Color="{DynamicResource AccentDeepColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource InkC_FF0B0B0E}" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- slow glows drifting behind the pages (Settings > Appearance turns them off) -->
            <Canvas x:Name="Haze" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="820" Height="820" Canvas.Left="120" Canvas.Top="-300" Tag="26">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentHazeColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentHazeFadeColor}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="900" Height="900" Canvas.Left="420" Canvas.Top="260" Tag="34">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentGlowFadeColor}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Title bar buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ThemeBtn" Style="{StaticResource WindowButton}" ToolTip="Settings" Click="OnThemeClick">
                    <Ellipse Width="13" Height="13" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource Ink_66FFFFFF}" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>

            <!-- ============ SETTINGS PAGE ============ -->
            <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="34,4,34,20">
                    <TextBlock Text="APP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"/>
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="How TrapShack looks and behaves. Everything here is remembered." FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="34,0,20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SECTIONS" Style="{StaticResource RailLabel}"/>
                        <ItemsControl x:Name="SettingsRail">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RailButton}" GroupName="setrail" IsChecked="{Binding Selected, Mode=OneWay}" Checked="OnSettingsRail"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,24">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SetGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SetTitle" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SetDesc" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="SetAppearance">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Accent colour" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Drag around the wheel for any colour you like. The whole app changes as you drag."
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ColorWheel x:Name="Wheel" Width="190" Height="190" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BRIGHTNESS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,6"/>
                                    <ui:BrightnessBar x:Name="ValueBar"/>

                                    <TextBlock Text="HEX CODE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="0,16,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="AccentPreview" Width="34" Height="34" CornerRadius="9" BorderBrush="{DynamicResource Ink_55FFFFFF}" BorderThickness="1" Margin="0,0,10,0"/>
                                        <TextBox x:Name="AccentHex" Width="120" MaxLength="9" Padding="8,7" Background="{DynamicResource Ink_FF0F0F13}" VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                                 CaretBrush="{DynamicResource TextBrush}" KeyDown="OnAccentHexKey" LostFocus="OnAccentHexLost"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AccentHexNote" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                               Text="Type a hex code and press Enter, or pick a ready-made colour:"/>
                                    <WrapPanel x:Name="SwatchRow" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Animated effects" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="The soft light that follows your mouse over cards, cards rising in, and the glow behind the pages. Turn off for a completely still app."
                                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="EffectsCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                          Checked="OnEffectsToggled" Unchecked="OnEffectsToggled"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Light theme" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="A soft grey look instead of black. Your accent colour carries over. The terminal stays dark."
                                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton x:Name="LightCheck" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"
                                          Checked="OnLightToggled" Unchecked="OnLightToggled"/>
                        </Grid>
                    </Border>

                    </StackPanel>
                    <StackPanel x:Name="SetProfiles" Visibility="Collapsed">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Save or load your settings" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProfileStatus" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Save which settings are on to a file, then load it on another PC to apply the same ones. Settings that don't suit that PC are skipped."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="Save profile" Margin="0,0,10,0" Click="OnExportProfile"/>
                                <Button Style="{StaticResource GhostButton}" Content="Load profile" Click="OnImportProfile"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </StackPanel>
                    <StackPanel x:Name="SetSafety" Visibility="Collapsed">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Restore point question" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RpSettingNote" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource MiniButton}" Content="Ask me again" VerticalAlignment="Center"
                                    Click="OnAskRestorePointAgain"/>
                        </Grid>
                    </Border>

                    </StackPanel>
                    <StackPanel x:Name="SetUpdates" Visibility="Collapsed">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- GitHub mark (Assets\Brand\github.png) used as a mask, so it takes the theme's text colour -->
                                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Ink_FF1A1A21}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Rectangle x:Name="GitHubMark" Width="24" Height="24" Fill="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="GitHubGlyph" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="App updates" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdStatus" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="Checks GitHub for a newer release."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="UpdCheck" Style="{StaticResource GhostButton}" Content="Check for updates" Click="OnCheckUpdate"/>
                                    <Button x:Name="UpdInstall" Style="{StaticResource PrimaryButton}" Content="Update now" Margin="10,0,0,0"
                                            Visibility="Collapsed" Click="OnInstallUpdate"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="UpdBar" Style="{StaticResource ThinBar}" Height="6" Margin="0,14,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ============ HOME PAGE: deliberately small ============ -->
            <ScrollViewer x:Name="HomePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="520">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="34,0,34,40">
                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Image Source="Assets/logo.png" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="Welcome to JS Tweak Utility" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <TextBlock x:Name="HomeSub" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <ui:AdaptiveGrid Columns="2" MinItemWidth="400" Gap="12" Margin="0,28,0,0">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16"
                                Padding="24,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HomeTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeCount" Grid.Column="1" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="HomeBar" Style="{StaticResource ThinBar}" Height="6" Margin="0,12,0,0"/>
                                <TextBlock x:Name="HomeText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button x:Name="ApplyAllButton" Style="{StaticResource PrimaryButton}" Content="Apply recommended" Click="OnApplyAll"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Create restore point" Margin="10,0,0,0" Click="OnRestorePoint"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- PC Cleaner: how much space a clean would free (measured quietly after startup) -->
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16"
                                Padding="24,20">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="PC Cleaner" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeCleanSize" Grid.Column="1" Text="…" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="HomeCleanText" Grid.Row="1" Text="Checking temporary files and caches…" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" LineHeight="18" Margin="0,30,0,0"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Clean now" Click="OnHomeClean"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </ui:AdaptiveGrid>

                        <!-- shown only when a Windows update (or anything else) changed settings back; never a pop-up -->
                        <Border x:Name="PutBackCard" Visibility="Collapsed" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="16" Padding="20,14" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="PutBackTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PutBackText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="Keep as is" Click="OnKeepAsIs"
                                            ToolTip="Leave these as Windows has them now. You can switch any of them on again yourself."/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Turn back on" Margin="10,0,0,0" Click="OnPutBack"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- quick jumps to the everyday tools -->
                        <ui:AdaptiveGrid Columns="4" MinItemWidth="200" Gap="12" Margin="0,12,0,0">
                            <Button Style="{StaticResource HomeTile}" Tag="startup" Click="OnHomeJump" Content="&#xE7E8;" ToolTip="Startup apps">
                                <Button.DataContext><ui:HomeTileInfo Title="Startup apps" Sub="What opens with Windows"/></Button.DataContext>
                            </Button>
                            <Button Style="{StaticResource HomeTile}" Tag="utilities" Click="OnHomeJump" Content="&#xE90F;" ToolTip="Utilities">
                                <Button.DataContext><ui:HomeTileInfo Title="Utilities" Sub="Repairs, network and DNS"/></Button.DataContext>
                            </Button>
                            <Button Style="{StaticResource HomeTile}" Tag="restore" Click="OnHomeJump" Content="&#xE81C;" ToolTip="Restore points">
                                <Button.DataContext><ui:HomeTileInfo Title="Restore points" Sub="See, make and delete"/></Button.DataContext>
                            </Button>
                            <Button Style="{StaticResource HomeTile}" Tag="system" Click="OnHomeJump" Content="&#xE7F8;" ToolTip="System info">
                                <Button.DataContext><ui:HomeTileInfo Title="System info" Sub="Hardware and live temps"/></Button.DataContext>
                            </Button>
                        </ui:AdaptiveGrid>

                        <Button Style="{StaticResource MiniButton}" Content="Undo everything TrapShack changed" HorizontalAlignment="Center" Margin="0,16,0,0"
                                Click="OnUndoAll" Opacity="0.85"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============ GLOBAL SEARCH ============ -->
            <Grid x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="34,4,34,12">
                    <TextBlock Text="Search settings" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Find any setting in the whole app by name or what it does." FontSize="13"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,14"/>
                    <Grid>
                        <TextBox x:Name="SearchAllBox" TextChanged="OnSearchAllChanged" Padding="14,10" FontSize="14"
                                 Background="{DynamicResource Ink_FF141418}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource Ink_FF2A2A32}"
                                 CaretBrush="{DynamicResource AccentHotBrush}"/>
                        <TextBlock x:Name="SearchAllHint" Text="Try: telemetry, copilot, taskbar, game mode…" IsHitTestVisible="False"
                                   FontSize="14" Foreground="{DynamicResource FaintBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="SearchAllCount" FontSize="12.5" Foreground="{DynamicResource AccentHotBrush}" Margin="2,10,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SearchAllList" Margin="34,0,34,24" ItemTemplate="{StaticResource SettingRow}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FaintBrush}" Margin="2,12,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ui:AdaptiveGrid Columns="2" MinItemWidth="380" Gap="10" RowHeight="64"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ OPTIMIZATIONS HUB ============ -->
            <ScrollViewer x:Name="HubPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="34,4,34,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock x:Name="HubTitle" Style="{StaticResource PageTitleText}" Text="Optimizations"/>
                            <TextBlock x:Name="HubBlurb" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="HubSummary" FontSize="12.5" Foreground="{DynamicResource AccentHotBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button x:Name="HubQuickBtn" Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="0,4,0,0" Click="OnQuickActions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,9,0" Foreground="{DynamicResource AccentHotBrush}"/>
                                <TextBlock Text="Quick actions"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="9,3,0,0" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- one featured card on the left, the other areas in a 3 x 2 grid beside it -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HubFeaturedCol" Width="*"/>
                            <ColumnDefinition x:Name="HubGapCol" Width="12"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="HubFeatured" ContentTemplate="{StaticResource HubFeaturedCard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        <ItemsControl x:Name="HubList" Grid.Column="2" ItemTemplate="{StaticResource HubCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="200" Gap="12"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ SYSTEM INFO PAGE: compact, meant to fit without scrolling ============ -->
            <ScrollViewer x:Name="SystemPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="34,4,34,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="System info" Style="{StaticResource PageTitleText}"/>
                            <TextBlock Text="What's inside this PC. Live temperatures and load have their own page." FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <!-- the specs as plain text, ready to paste into Discord when asking for help -->
                        <Button x:Name="CopySpecsBtn" Grid.Column="1" Style="{StaticResource GhostButton}" Height="40" VerticalAlignment="Bottom" Margin="16,0,0,0"
                                Click="OnCopySpecs" IsEnabled="False" ToolTip="Copies this PC's specs as text, ready to paste into Discord. Leaves out the PC name and network details.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CopySpecsIcon" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,8,0"/>
                                <TextBlock x:Name="CopySpecsText" Text="Copy specs"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- PC header: one slim strip -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Image Source="Assets/logo.png" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SysName" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SysLine" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ItemsControl x:Name="SysChips" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="420">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,1.5" Margin="5,2,0,2" Background="{DynamicResource Ink_FF1C1C22}" BorderBrush="{DynamicResource Ink_FF33333C}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- specs: the same cards as the Temperatures page, three to a row -->
                    <ItemsControl x:Name="InfoList" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="290" Gap="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,16,18,10"
                                        ui:Fx.Glow="True">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Rectangle Height="1" Fill="{DynamicResource Ink_FF1E1E25}" Margin="0,14,0,12"/>
                                        <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,0,16,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ SETTINGS PAGES (Debloat and every Optimizations page) ============ -->
            <Grid x:Name="TweakPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- header: title on the left, search and the page action on the right, one line -->
                <Grid Grid.Row="0" Margin="34,4,34,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,20,0">
                        <TextBlock x:Name="PageCrumb" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,3"
/>
                        <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}"/>
                        <TextBlock x:Name="PageSubtitle" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="300" VerticalAlignment="Bottom">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Height="40" Padding="36,0,12,0" VerticalContentAlignment="Center" FontSize="13"
                                 Background="{DynamicResource Ink_FF141418}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource Ink_FF2A2A32}"
                                 CaretBrush="{DynamicResource AccentHotBrush}"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False" Foreground="{DynamicResource FaintBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchHint" Text="Search this page   Ctrl+F" IsHitTestVisible="False" FontSize="13"
                                   Foreground="{DynamicResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="QuickBtn" Grid.Column="2" Style="{StaticResource GhostButton}" Height="40" Margin="12,0,0,0" VerticalAlignment="Bottom" Click="OnQuickActions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,9,0" Foreground="{DynamicResource AccentHotBrush}"/>
                            <TextBlock x:Name="QuickBtnText" Text="Quick actions"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="9,3,0,0" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="34,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- the page's categories: a plain list, never a box -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock x:Name="RailLabel" Style="{StaticResource RailLabel}"/>
                            <ItemsControl x:Name="RailList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource RailButton}" GroupName="rail" IsChecked="{Binding Selected, Mode=OneWay}" Checked="OnRailPick"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- the page's overall state, once -->
                            <Border BorderBrush="{DynamicResource Ink_FF1E1E25}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="12,14,8,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="Recommended on" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="StatRec" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="Left at Windows default" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="StatDef" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink_FFD7D7DE}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Your own picks" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="StatCustom" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- the chosen category -->
                    <ScrollViewer x:Name="TweakScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,14,24">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="CatGlyph" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource AccentHotBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="CatTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CatDesc" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="CatProgress" Grid.Column="2" Width="140" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="CatCount" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                                        <ProgressBar x:Name="CatBar" Style="{StaticResource ThinBar}" Height="4" Margin="0,6,0,0" Maximum="1"/>
                                    </StackPanel>
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Button x:Name="CatRecBtn" Style="{StaticResource PrimaryButton}" Height="36" Click="OnCatRecommended"/>
                                        <TextBlock x:Name="CatRecDone" Text="&#xE73E;  Recommended are on" FontSize="12.5" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="PanelEmpty" Text="Nothing matches that. Try another word." Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" Visibility="Collapsed"/>
                            <!-- every row the same height, two even columns; an odd last row spans both -->
                            <ItemsControl x:Name="TweakList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <!-- a small heading when an area holds several groups -->
                                            <Grid Margin="2,0,0,10" Visibility="{Binding ShowTitle, Converter={StaticResource B2V}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="10,1,0,0"/>
                                                <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource Ink_FF1E1E25}" VerticalAlignment="Center" Margin="14,2,0,0"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource RowSel}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><ui:AdaptiveGrid Columns="2" MinItemWidth="380" Gap="10" RowHeight="64"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="CatFoot" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="2,0,0,0" TextWrapping="Wrap"
                                       Text="Every switch can be turned back off. TrapShack keeps the original Windows value."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <ui:AppsPage x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:DebloatAppsPage x:Name="DebloatAppsPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:CleanerPage x:Name="CleanerPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:UtilitiesPage x:Name="UtilitiesPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:StartupPage x:Name="StartupPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:RestorePage x:Name="RestorePanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:MonitorPage x:Name="MonitorPanel" Grid.Row="1" Visibility="Collapsed"/>

            <!-- ============ QUICK ACTIONS MENU (one menu, shared by every page that has the button) ============ -->
            <Popup x:Name="QuickPop" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                <Border Background="{DynamicResource Ink_FF111116}" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8" Width="340">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                    </Border.LayoutTransform>
                    <StackPanel>
                        <TextBlock x:Name="QuickScope" Text="QUICK ACTIONS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="12,6,0,6"/>

                        <Button x:Name="QuickApplyBtn" Style="{StaticResource MenuRow}" Click="OnApplyPage">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Apply recommended" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="QuickApplySub" Text="Turn on the settings picked for this PC" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="QuickApplyPill" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Ink_FF1C1C22}">
                                    <TextBlock x:Name="QuickApplyCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="QuickResetBtn" Style="{StaticResource MenuRow}" Click="OnUndoPage">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Ink_FF1D1D24}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Restore Windows defaults" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="QuickResetSub" Text="Put the changed settings back" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Ink_FF1C1C22}">
                                    <TextBlock x:Name="QuickResetCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

                        <!-- ============ STATUS BAR ============ -->
            <Border x:Name="StatusBar" Grid.Row="2" Height="34" Visibility="Collapsed" BorderBrush="{DynamicResource Ink_FF17171C}" BorderThickness="0,1,0,0" Background="{DynamicResource Ink_FF09090C}">
                <Grid Margin="40,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
            </Border>

            <ui:ProgressDock x:Name="Apply" Grid.RowSpan="3"/>

            <!-- Restart prompt: only shown once every queued change has finished -->
            <Border x:Name="RestartBar" Grid.RowSpan="3" MinWidth="460" MaxWidth="640" Margin="24,0,24,22"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"
                    Background="{DynamicResource Ink_FF131317}" BorderBrush="{DynamicResource Ink_FF34343D}" BorderThickness="1" CornerRadius="14" Padding="16,13">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AmberBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="RestartTitle" Text="Restart to finish" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RestartSub" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="RestartLaterBtn" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Later" FontSize="12.5"
                            Margin="0,0,8,0" Click="OnRestartLater"/>
                    <Button x:Name="RestartNowBtn" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Restart now" FontSize="12.5"
                            IsEnabled="False" Click="OnRestartNow"/>
                </Grid>
            </Border>

            <!-- ============ BUSY OVERLAY ============ -->
            <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Background="{DynamicResource Ink_D80B0B0E}" Visibility="Collapsed">
                <Border Background="{DynamicResource Ink_FF141418}" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="14"
                        Padding="34,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" MaxWidth="560">
                    <StackPanel>
                        <TextBlock x:Name="BusyText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Please keep this window open." FontSize="12.5"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/>
                        <Border Height="5" CornerRadius="3" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                            <Border Width="130" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{DynamicResource AccentBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="BusySlide" X="-130"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- =========================== SPLASH =========================== -->
        <Grid x:Name="Splash" Grid.ColumnSpan="2" Panel.ZIndex="100">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="{DynamicResource AccentDeeperColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource InkC_FF09090B}" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="230" Height="230" HorizontalAlignment="Center">
                    <Ellipse x:Name="SplashGlow" Width="170" Height="170" Fill="{DynamicResource AccentBrush}" Opacity="0.35">
                        <Ellipse.Effect>
                            <BlurEffect Radius="46"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Image Source="Assets/logo.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="TWEAK UTILITY" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,34"/>
                <ProgressBar x:Name="SplashBar" Style="{StaticResource ThinBar}" Width="340" Value="0.04"/>
                <TextBlock x:Name="SplashStatus" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Text="Starting..."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
