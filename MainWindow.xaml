<Window x:Class="TrapShack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TrapShack.Ui"
        Title="TrapShack Tweak Utility" Width="1220" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="OnLoaded" StateChanged="OnStateChanged" SizeChanged="OnWindowSizeChanged" PreviewKeyDown="OnWindowKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Section title that folds its cards up -->
        <Style x:Key="SectionHeader" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,12,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Car" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="2,0,9,0"
                                           Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Car" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Car" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small pill used for Recommended / Caution / Not available -->
        <Style x:Key="FitPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FitKind}" Value="Recommended">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentHotBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitKind}" Value="Caution">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#26F5A524"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FitKind}" Value="Unavailable">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="#22FFFFFF"/>
                    <Setter Property="TextElement.Foreground" Value="#9A9AA7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ One setting: a compact tile ============ -->
        <DataTemplate DataType="{x:Type ui:TweakVM}">
            <Border Padding="13,11,11,8" CornerRadius="12" BorderThickness="1" ui:Fx.Glow="True" ui:Fx.Rise="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPanelBorderBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="#3A3A45"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Width="32" Height="32" CornerRadius="9" Margin="0,1,11,0" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1D1D24"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RowGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAdvanced}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Title}"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="16" Margin="0,3,8,0" VerticalAlignment="Top"/>

                    <ToggleButton Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="0,2,0,0"
                                  IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                  Visibility="{Binding IsSwitch, Converter={StaticResource B2V}}" Click="OnSwitchClick"/>
                    <Button Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource MiniButton}" Content="Run now" VerticalAlignment="Top" Margin="0,2,0,0"
                            IsEnabled="{Binding CanToggle}" Visibility="{Binding IsOneShot, Converter={StaticResource B2V}}" Click="OnRunNowClick"/>

                    <!-- footer: how well it fits this PC, and the details button -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource FitPill}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding FitText}" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Visibility="{Binding HasTags, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                        <ToggleButton x:Name="InfoBtn" Grid.Column="1" Style="{StaticResource InfoToggle}" ToolTip="What this does"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=InfoBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=InfoBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                            <Border Background="#111116" BorderBrush="#34343D" BorderThickness="1" CornerRadius="12" Padding="16,14" Width="390">
                                <Border.LayoutTransform>
                                    <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                                </Border.LayoutTransform>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailText}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="#C7C7D1" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource AmberBrush}" Margin="0,8,0,0"
                                               Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                    <TextBlock Text="WHAT IT CHANGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" Margin="0,12,0,4"/>
                                    <ItemsControl ItemsSource="{Binding ChangeLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RestoreNote}" FontSize="12" Foreground="{DynamicResource AccentHotBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- one page on the Optimizations hub -->
        <DataTemplate x:Key="HubCard" DataType="{x:Type ui:HubRow}">
            <Border Tag="{Binding Key}" MouseLeftButtonUp="OnHubRowClick" Padding="18,16,18,14" CornerRadius="14" BorderThickness="1" Cursor="Hand"
                    ui:Fx.Glow="True" ui:Fx.Rise="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,13,0">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AccentHotBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Groups}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="16" Margin="0,12,0,0" VerticalAlignment="Top"/>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding HasRec, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource ThinBar}" Height="4" Value="{Binding RecFill, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Rec}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}" Margin="10,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,9,0,0">
                        <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,0" Background="#1C1C22">
                            <TextBlock Text="{Binding Def}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="7,2" Background="#2A2412" Visibility="{Binding HasCustom, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding Custom}" FontSize="11" Foreground="{StaticResource AmberBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>


        <!-- ============ DEBLOAT PAGE: one compact row per setting inside a category card ============ -->
        <DataTemplate x:Key="DebloatTweakRow" DataType="{x:Type ui:TweakVM}">
            <Border Padding="8,5,4,5" CornerRadius="8" Background="Transparent" x:Name="RowBg">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- small marker: accent = recommended, amber = take care -->
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FitKind}" Value="Recommended">
                                        <Setter Property="Fill" Value="{DynamicResource AccentHotBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FitKind}" Value="Caution">
                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Summary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FitKind}" Value="Unavailable">
                                        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ToggleButton x:Name="InfoBtn" Grid.Column="2" Style="{StaticResource InfoToggle}" ToolTip="What this does" Margin="6,0,6,0" VerticalAlignment="Center"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=InfoBtn, Mode=TwoWay}" PlacementTarget="{Binding ElementName=InfoBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                        <Border Background="#111116" BorderBrush="#34343D" BorderThickness="1" CornerRadius="12" Padding="16,14" Width="390">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                            </Border.LayoutTransform>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="#C7C7D1" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Note}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource AmberBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="WHAT IT CHANGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" Margin="0,12,0,4"/>
                                <ItemsControl ItemsSource="{Binding ChangeLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RestoreNote}" FontSize="12" Foreground="{DynamicResource AccentHotBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                  Visibility="{Binding IsSwitch, Converter={StaticResource B2V}}" Click="OnSwitchClick">
                        <ToggleButton.LayoutTransform><ScaleTransform ScaleX="0.82" ScaleY="0.82"/></ToggleButton.LayoutTransform>
                    </ToggleButton>
                    <Button Grid.Column="3" Style="{StaticResource MiniButton}" Content="Run" VerticalAlignment="Center"
                            IsEnabled="{Binding CanToggle}" Visibility="{Binding IsOneShot, Converter={StaticResource B2V}}" Click="OnRunNowClick"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowBg" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBg" Property="Background" Value="#17171D"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a drop-down: several settings of which only one can be in effect -->
        <DataTemplate x:Key="DebloatChoiceRow" DataType="{x:Type ui:ChoiceVM}">
            <Grid Margin="8,6,4,6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,5"/>
                <ToggleButton x:Name="Drop" Grid.Row="1" IsEnabled="{Binding CanPick}" Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="#101014" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="8" Padding="11,7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedLabel}" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentEdgeBrush}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup Grid.Row="1" IsOpen="{Binding IsChecked, ElementName=Drop, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Drop}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4"
                       MinWidth="{Binding ActualWidth, ElementName=Drop}">
                    <Border Background="#111116" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
                        <Border.LayoutTransform>
                            <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                        </Border.LayoutTransform>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnChoicePick" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Ob" Background="Transparent" CornerRadius="7" Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentHotBrush}" VerticalAlignment="Center" Visibility="Hidden"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ob" Property="Background" Value="#1D1D24"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <ui:DebloatRowSelector x:Key="DebloatRowSel" TweakTemplate="{StaticResource DebloatTweakRow}" ChoiceTemplate="{StaticResource DebloatChoiceRow}"/>

        <!-- one category card -->
        <DataTemplate x:Key="DebloatCard" DataType="{x:Type ui:DebloatCategoryVM}">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="10,12,10,8"
                    ui:Fx.Rise="True">
                <StackPanel>
                    <Grid Margin="6,0,6,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentHotBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11.5" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" ToolTip="Switched on"/>
                    </Grid>
                    <Rectangle Height="1" Fill="#1E1E25" Margin="6,0,6,4"/>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource DebloatRowSel}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="Margin" Value="2,24,0,10"/>
        </Style>

        <!-- Page title block used by every page -->
        <Style x:Key="PageTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform><ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========================== SIDEBAR =========================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#17171C" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,18">
                    <Grid Width="44" Height="44">
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Image Source="Assets/logo.png" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TRAPSHACK" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="TWEAK UTILITY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="22,10,16,18">
                    <TextBlock x:Name="SidebarSystem" FontSize="11" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="v0.1.0" FontSize="11" Foreground="#4C4C57" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Rectangle Height="1" Fill="#17171C" Margin="16,0,16,8"/>
                    <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" Tag="&#xE770;"
                                 Content="System info" GroupName="nav" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;"
                                 Content="Settings" GroupName="nav" Checked="OnNavChecked"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Margin="0,2,0,0"
                                     Content="Home" GroupName="nav" IsChecked="True" Checked="OnNavChecked"/>
                        <StackPanel x:Name="NavHost"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- =========================== CONTENT =========================== -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.9" RadiusY="0.7">
                    <GradientStop Color="{DynamicResource AccentDeepColor}" Offset="0"/>
                    <GradientStop Color="#0B0B0E" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- slow glows drifting behind the pages (Settings > Appearance turns them off) -->
            <Canvas x:Name="Haze" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="820" Height="820" Canvas.Left="120" Canvas.Top="-300" Tag="26">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentHazeColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentHazeFadeColor}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="900" Height="900" Canvas.Left="420" Canvas.Top="260" Tag="34">
                    <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentGlowFadeColor}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Title bar buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="ThemeBtn" Style="{StaticResource WindowButton}" ToolTip="Settings" Click="OnThemeClick">
                    <Ellipse Width="13" Height="13" Fill="{DynamicResource AccentBrush}" Stroke="#66FFFFFF" StrokeThickness="1"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>

            <!-- ============ SETTINGS PAGE ============ -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,4,34,28" MaxWidth="860" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="How TrapShack looks and behaves. Everything here is remembered." FontSize="13"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Accent colour" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Drag around the wheel for any colour you like. The whole app changes as you drag."
                                       FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ColorWheel x:Name="Wheel" Width="190" Height="190" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BRIGHTNESS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" Margin="0,0,0,6"/>
                                    <ui:BrightnessBar x:Name="ValueBar"/>

                                    <TextBlock Text="HEX CODE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" Margin="0,16,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="AccentPreview" Width="34" Height="34" CornerRadius="9" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0"/>
                                        <TextBox x:Name="AccentHex" Width="120" MaxLength="9" Padding="8,7" Background="#0F0F13" VerticalContentAlignment="Center"
                                                 Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                                 CaretBrush="White" KeyDown="OnAccentHexKey" LostFocus="OnAccentHexLost"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AccentHexNote" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                               Text="Type a hex code and press Enter, or pick a ready-made colour:"/>
                                    <WrapPanel x:Name="SwatchRow" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Animated effects" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="The soft light that follows your mouse over cards, cards rising in, and the slow glow behind the pages. Turn off for a completely still app."
                                           FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="EffectsCheck" Grid.Column="1" Style="{StaticResource TsCheck}" VerticalAlignment="Center" Margin="20,0,0,0"
                                      Checked="OnEffectsToggled" Unchecked="OnEffectsToggled"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="SAFETY" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Restore point question" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RpSettingNote" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource MiniButton}" Content="Ask me again" VerticalAlignment="Center"
                                    Click="OnAskRestorePointAgain"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="14" Padding="20,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock x:Name="UpdVersion" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdStatus" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Checks the releases of the GitHub repository below."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="UpdCheck" Style="{StaticResource MiniButton}" Content="Check for updates" Click="OnCheckUpdate"/>
                                    <Button x:Name="UpdInstall" Style="{StaticResource PrimaryButton}" Content="Update now" Margin="10,0,0,0"
                                            Visibility="Collapsed" Click="OnInstallUpdate"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="UpdBar" Style="{StaticResource ThinBar}" Height="6" Margin="0,14,0,0" Visibility="Collapsed"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Updates come from" FontSize="12.5" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox x:Name="UpdRepo" Grid.Column="1" Padding="8,7" Background="#0F0F13" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrushSoft}" CaretBrush="White" LostFocus="OnUpdRepoChanged"/>
                                <TextBlock Grid.Column="2" Text="owner/name on GitHub" FontSize="12" Foreground="{StaticResource FaintBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ HOME PAGE: deliberately small ============ -->
            <ScrollViewer x:Name="HomePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="520">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,30,40">
                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="3">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Image Source="Assets/logo.png" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="Welcome to TrapShack" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <TextBlock x:Name="HomeSub" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16"
                                Padding="26,22" Margin="0,28,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HomeTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomeCount" Grid.Column="1" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="HomeBar" Style="{StaticResource ThinBar}" Height="6" Margin="0,12,0,0"/>
                                <TextBlock x:Name="HomeText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button x:Name="ApplyAllButton" Style="{StaticResource PrimaryButton}" Content="Apply recommended" Click="OnApplyAll"/>
                                    <Button Style="{StaticResource GhostButton}" Content="Create restore point" Margin="10,0,0,0" Click="OnRestorePoint"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource MiniButton}" Content="Undo everything TrapShack changed" HorizontalAlignment="Center" Margin="0,16,0,0"
                                Click="OnUndoAll" Opacity="0.85"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============ GLOBAL SEARCH ============ -->
            <Grid x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="34,4,34,12">
                    <TextBlock Text="Search settings" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Find any setting in the whole app by name or what it does." FontSize="13"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14"/>
                    <Grid>
                        <TextBox x:Name="SearchAllBox" TextChanged="OnSearchAllChanged" Padding="14,10" FontSize="14"
                                 Background="#141418" Foreground="{StaticResource TextBrush}" BorderBrush="#2A2A32"
                                 CaretBrush="{DynamicResource AccentHotBrush}"/>
                        <TextBlock x:Name="SearchAllHint" Text="Try: telemetry, copilot, taskbar, game mode…" IsHitTestVisible="False"
                                   FontSize="14" Foreground="{StaticResource FaintBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="SearchAllCount" FontSize="12.5" Foreground="{DynamicResource AccentHotBrush}" Margin="2,10,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SearchAllList" Margin="34,0,34,24">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource FaintBrush}" Margin="2,12,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="250" Gap="10"/></ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============ OPTIMIZATIONS HUB ============ -->
            <ScrollViewer x:Name="HubPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="34,4,34,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock x:Name="HubTitle" Style="{StaticResource PageTitleText}" Text="Optimizations"/>
                            <TextBlock x:Name="HubBlurb" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="HubSummary" FontSize="12.5" Foreground="{DynamicResource AccentHotBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button x:Name="HubQuickBtn" Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="0,4,0,0" Click="OnQuickActions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,9,0" Foreground="{DynamicResource AccentHotBrush}"/>
                                <TextBlock Text="Quick actions"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="9,3,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="HubList" Margin="0,20,0,0" ItemTemplate="{StaticResource HubCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="250" Gap="12"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ SYSTEM INFO PAGE: compact, meant to fit without scrolling ============ -->
            <ScrollViewer x:Name="SystemPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="34,4,34,16">
                    <TextBlock Text="System info" Style="{StaticResource PageTitleText}"/>

                    <!-- PC header: one slim strip -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Image Source="Assets/logo.png" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SysName" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SysLine" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ItemsControl x:Name="SysChips" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="420">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,1.5" Margin="5,2,0,2" Background="#1C1C22" BorderBrush="#33333C" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- live -->
                    <Grid Margin="0,12,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LiveNote" Grid.Column="1" Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ItemsControl x:Name="LiveList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="200" Gap="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="13,9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Headline}" FontSize="16" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Hot}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentHotBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource ThinBar}" Height="3" Margin="0,5,0,5"
                                                     Value="{Binding Fill, Mode=OneWay}" Visibility="{Binding BarVisible}"/>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- specs: four narrow columns so everything is visible at once -->
                    <TextBlock Text="THIS PC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" Margin="0,14,0,7"/>
                    <ItemsControl x:Name="InfoList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ui:AdaptiveGrid Columns="4" MinItemWidth="200" Gap="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <Border BorderBrush="#1E1E25" BorderThickness="0,0,0,1" Padding="12,6">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="12,4,12,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1.5">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource FaintBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ SETTINGS PAGES (Debloat and every Optimizations page) ============ -->
            <Grid x:Name="TweakPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="34,4,34,10">
                    <TextBlock x:Name="PageCrumb" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentHotBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}"/>
                    <TextBlock x:Name="PageSubtitle" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="34,0,34,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Padding="36,9,12,9" FontSize="13"
                                 Background="#141418" Foreground="{StaticResource TextBrush}" BorderBrush="#2A2A32"
                                 CaretBrush="{DynamicResource AccentHotBrush}"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" IsHitTestVisible="False" Foreground="{StaticResource FaintBrush}" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchHint" Text="Search this page   (Ctrl+F)" IsHitTestVisible="False" FontSize="13"
                                   Foreground="{StaticResource FaintBrush}" Margin="36,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border x:Name="BadgeRec" CornerRadius="10" Padding="9,3" Margin="0,0,6,0" Background="#1A2A22" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1">
                            <TextBlock x:Name="BadgeRecText" FontSize="11.5" Foreground="{StaticResource GreenBrush}"/>
                        </Border>
                        <Border CornerRadius="10" Padding="9,3" Margin="0,0,6,0" Background="#1C1C22" BorderBrush="#33333C" BorderThickness="1">
                            <TextBlock x:Name="BadgeDefText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <Border x:Name="BadgeCustom" CornerRadius="10" Padding="9,3" Background="#2A2412" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1">
                            <TextBlock x:Name="BadgeCustomText" FontSize="11.5" Foreground="{StaticResource AmberBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="QuickBtn" Grid.Column="2" Style="{StaticResource GhostButton}" Margin="14,0,0,0" Click="OnQuickActions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,1,9,0" Foreground="{DynamicResource AccentHotBrush}"/>
                            <TextBlock x:Name="QuickBtnText" Text="Quick actions"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="9,3,0,0" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="PanelScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="34,2,34,24">
                        <TextBlock x:Name="PanelEmpty" Text="Nothing matches that." Foreground="{StaticResource MutedBrush}" Margin="2,6,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="PanelList" ItemTemplate="{StaticResource DebloatCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ui:MasonryPanel Columns="3" MinColumnWidth="290" Gap="12"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TweakScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TweakList" Margin="34,0,34,24">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="Hd" Style="{StaticResource SectionHeader}" IsChecked="True"
                                                                      Loaded="OnSectionHeaderLoaded" Checked="OnSectionToggled" Unchecked="OnSectionToggled">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource MutedBrush}"/>
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="12" Margin="8,0,0,0"
                                                                           Foreground="{StaticResource FaintBrush}"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ItemsPresenter x:Name="Body"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger SourceName="Hd" Property="IsChecked" Value="False">
                                                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate><ui:AdaptiveGrid Columns="3" MinItemWidth="250" Gap="10"/></ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <ui:AppsPage x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:DebloatAppsPage x:Name="DebloatAppsPanel" Grid.Row="1" Visibility="Collapsed"/>
            <ui:CleanerPage x:Name="CleanerPanel" Grid.Row="1" Visibility="Collapsed"/>

            <!-- ============ QUICK ACTIONS MENU (one menu, shared by every page that has the button) ============ -->
            <Popup x:Name="QuickPop" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                <Border Background="#111116" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8" Width="340">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{DynamicResource UiScaleFactor}" ScaleY="{DynamicResource UiScaleFactor}"/>
                    </Border.LayoutTransform>
                    <StackPanel>
                        <TextBlock x:Name="QuickScope" Text="QUICK ACTIONS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" Margin="12,6,0,6"/>

                        <Button x:Name="QuickApplyBtn" Style="{StaticResource MenuRow}" Click="OnApplyPage">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentHotBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Apply recommended" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="QuickApplySub" Text="Turn on the settings picked for this PC" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" x:Name="QuickApplyPill" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="#1C1C22">
                                    <TextBlock x:Name="QuickApplyCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="QuickResetBtn" Style="{StaticResource MenuRow}" Click="OnUndoPage">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#1D1D24" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Restore Windows defaults" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="QuickResetSub" Text="Put the changed settings back" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="#1C1C22">
                                    <TextBlock x:Name="QuickResetCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

                        <!-- ============ STATUS BAR ============ -->
            <Border Grid.Row="2" BorderBrush="#17171C" BorderThickness="0,1,0,0" Background="#09090C">
                <Grid Margin="40,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>

            <ui:ProgressDock x:Name="Apply" Grid.RowSpan="3"/>

            <!-- Restart prompt: only shown once every queued change has finished -->
            <Border x:Name="RestartBar" Grid.RowSpan="3" MinWidth="460" MaxWidth="640" Margin="24,0,24,22"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"
                    Background="#131317" BorderBrush="#34343D" BorderThickness="1" CornerRadius="14" Padding="16,13">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AmberBrush}" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="RestartTitle" Text="Restart to finish" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RestartSub" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="RestartLaterBtn" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Later" FontSize="12.5"
                            Margin="0,0,8,0" Click="OnRestartLater"/>
                    <Button x:Name="RestartNowBtn" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Restart now" FontSize="12.5"
                            IsEnabled="False" Click="OnRestartNow"/>
                </Grid>
            </Border>

            <!-- ============ BUSY OVERLAY ============ -->
            <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Background="#D80B0B0E" Visibility="Collapsed">
                <Border Background="#141418" BorderBrush="{DynamicResource AccentPanelBorderBrush}" BorderThickness="1" CornerRadius="14"
                        Padding="34,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" MaxWidth="560">
                    <StackPanel>
                        <TextBlock x:Name="BusyText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Please keep this window open." FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/>
                        <Border Height="5" CornerRadius="3" Background="{StaticResource TrackBrush}" ClipToBounds="True">
                            <Border Width="130" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{DynamicResource AccentBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="BusySlide" X="-130"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="BusySlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-130" To="520" Duration="0:0:1.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- =========================== SPLASH =========================== -->
        <Grid x:Name="Splash" Grid.ColumnSpan="2" Panel.ZIndex="100">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="{DynamicResource AccentDeeperColor}" Offset="0"/>
                    <GradientStop Color="#09090B" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="230" Height="230" HorizontalAlignment="Center">
                    <Ellipse Width="170" Height="170" Fill="{DynamicResource AccentBrush}" Opacity="0.35">
                        <Ellipse.Effect>
                            <BlurEffect Radius="46"/>
                        </Ellipse.Effect>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="0.6" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Image Source="Assets/logo.png" Width="200" Height="200" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <TextBlock Text="TWEAK UTILITY" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentHotBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,34"/>
                <ProgressBar x:Name="SplashBar" Style="{StaticResource ThinBar}" Width="340" Value="0.04"/>
                <TextBlock x:Name="SplashStatus" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Text="Starting..."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
